# 1. Dependency Directories (Heavy - Never commit these)
node_modules/
*/node_modules/

# 2. Environment Variables (Secrets - NEVER commit these)
.env
.env.local
.env.*.local
*/.env

# 3. Logs (Generated by Winston or npm)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 4. OS Generated Files (Junk)
.DS_Store
Thumbs.db

# 5. Docker (Optional, usually we commit Dockerfiles, but ignore local builds)
docker-compose.override.yml

# 6. IDE Settings (Optional)
.vscode/
.idea/